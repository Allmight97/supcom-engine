#!/usr/bin/env bash
# Fork commit guard. mac/scripts/setup copies it to .git/mac-hooks/, so it also runs on branches without mac/.
# Every commit: refuse game content, screenshots, saves, replays, Windows executables, new files over 1 MiB,
# anything under mac/work/, and mac/ code (scripts and .py, .sh, .lua, .swift, .cmake) over 8,000 tokens, so an
# agent can read any toolkit file whole. A commit that touches mac/, AGENTS.md, CLAUDE.md or README.md also needs
# mac/scripts/check to have passed on exactly the staged content, deletions included.
set -euo pipefail
max_bytes=1048576
rejected=0
root=$(git rev-parse --show-toplevel)
toolkit="$root/mac"

check_file() { # PATH: refuse game content by name, size or header
    local path=$1 reason="" size
    shopt -s nocasematch
    case "$path" in
        mac/work/*) reason="local-only directory" ;;
        *.exe|*.dll|*.bin|*.scd|*.scmap|*.sca|*.scm|*.dds|*.sav|*.scfareplay|*.oscsave|*.oscreplay|*.png|*.jpg|*.jpeg|*.gpr|*.rep|*.gzf)
            reason="game, analysis, screenshot, save or replay file type" ;;
    esac
    shopt -u nocasematch
    if [[ -z "$reason" ]]; then
        size=$(git cat-file -s ":$path")
        if (( size > max_bytes )); then
            reason="larger than $max_bytes bytes ($size)"
        elif [[ "$(git cat-file -p ":$path" | head -c 2)" == "MZ" ]]; then
            reason="Windows executable header"
        fi
    fi
    if [[ -n "$reason" ]]; then
        printf 'pre-commit: refusing %s: %s\n' "$path" "$reason" >&2
        rejected=1
    fi
}
# Upstream tracks large files and images; only new ones are checked outside mac/.
while IFS= read -r -d '' path; do check_file "$path"; done < <(git diff --cached --name-only --diff-filter=AC -z)
while IFS= read -r -d '' path; do check_file "$path"; done < <(git diff --cached --name-only --diff-filter=MR -z -- mac/)

max_code_bytes=32000
while IFS= read -r -d '' path; do
    case "$path" in
        *.py|*.sh|*.lua|*.swift|*.cmake) ;;
        *) [[ ${path##*/} != *.* && "$(git cat-file -p ":$path" | head -c 2)" == '#!' ]] || continue ;;
    esac
    size=$(git cat-file -s ":$path")
    if (( size > max_code_bytes )); then
        printf 'pre-commit: refusing %s: ~%d tokens (bytes / 4), over the 8,000-token budget for toolkit code.\n' \
            "$path" $((size / 4)) >&2
        printf '  Split it by concept: each new file owns one idea and is named for it (no part1, utils or misc).\n' >&2
        printf '  Move whole functions with the contract their callers rely on. Commit the split on its own,\n' >&2
        printf '  proven by mac/scripts/check, before the change that needed the room.\n' >&2
        rejected=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- mac/)

protected=$(git diff --cached --name-only -- mac/ AGENTS.md CLAUDE.md README.md)
if [[ -n $protected && -x "$toolkit/scripts/check" ]]; then
    untracked=$(git diff --cached --name-only --diff-filter=ACMR -- mac/ | xargs -r -n1 dirname | sort -u \
        | while read -r dir; do git ls-files --others --exclude-standard -- "$dir"; done | sort -u)
    if [[ -n $untracked && ! -e "$(git rev-parse --git-path MERGE_HEAD)" ]]; then
        printf 'pre-commit: untracked files sit in mac/ folders this commit touches; git add or ignore them:\n%s\n' "$untracked" >&2
        rejected=1
    fi
    read -r checked result _ < "$toolkit/work/check-last.txt" 2>/dev/null || { checked=0; result=none; }
    unchecked=$(git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -r git --literal-pathspecs ls-files -s -- \
        | LC_ALL=C sort | LC_ALL=C comm -23 - <(LC_ALL=C sort "$toolkit/work/check-last.manifest" 2>/dev/null))
    deleted=$(git diff --cached --name-only --diff-filter=D | LC_ALL=C sort \
        | LC_ALL=C comm -12 - <(cut -f2 "$toolkit/work/check-last.manifest" 2>/dev/null | LC_ALL=C sort))
    [[ -n $deleted ]] && unchecked=$(printf '%s\n%s' "$unchecked" "$(sed 's/^/deleted\t/' <<< "$deleted")" | sed '/^$/d')
    if [[ $result != pass || -n $unchecked ]]; then
        printf 'pre-commit: mac/scripts/check must pass on exactly the content you commit (mac/work/check-last.txt: %s at %s).\n' "$result" "$checked" >&2
        if [[ -n $unchecked ]]; then
            printf 'Changed since the check (git add new files before the check; edit nothing after it):\n%s\n' \
                "$(printf '%s\n' "$unchecked" | cut -f2 | head -5)" >&2
        fi
        rejected=1
    fi
fi

if (( rejected )); then
    printf 'Commit refused (mac/AGENTS.md: game content stays local; mac/scripts/check passes before toolkit commits).\n' >&2
    exit 1
fi
