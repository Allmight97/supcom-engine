#!/usr/bin/env bash
# Fork push guard (copied to .git/mac-hooks/ by mac/scripts/setup). A push from or to an up/* branch is an
# upstream pull request: cut from upstream/main with engine commits only. Refuse it if a new commit touches
# fork-only paths (mac/, any AGENTS*.md or CLAUDE.md, the fork's workflow) or its message names an agent,
# a model or a local path (guard-shell --upstream-text). Commits already on the remote stay as they are.
set -euo pipefail
zero=0000000000000000000000000000000000000000
rejected=0
text_check="$(dirname "$0")/claude/guard-shell"
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ ($local_ref == refs/heads/up/* || $remote_ref == refs/heads/up/*) && $local_sha != "$zero" ]] || continue
    branch=${remote_ref#refs/heads/}
    if ! git rev-parse --verify -q refs/remotes/upstream/main >/dev/null; then
        printf 'pre-push: %s: no upstream/main to compare with (git fetch upstream).\n' "$branch" >&2
        rejected=1
        continue
    fi
    range=upstream/main..$local_sha
    [[ $remote_sha != "$zero" ]] && git cat-file -e "$remote_sha" 2>/dev/null && range="$range ^$remote_sha"
    fork_only=$(git rev-list --full-history $range -- mac ':(glob)**/AGENTS*.md' ':(glob)**/CLAUDE.md' \
        .github/workflows/mac-upstream-watch.yml)
    if [[ -n $fork_only ]]; then
        printf 'pre-push: %s carries fork-only commits (mac/, AGENTS*.md, CLAUDE.md or mac-upstream-watch.yml):\n%s\n' \
            "$branch" "$(git log --oneline --no-walk $fork_only | head -5)" >&2
        rejected=1
    fi
    [[ -x $text_check ]] || { echo "pre-push: $text_check is missing; run mac/scripts/setup." >&2; rejected=1; continue; }
    if ! named=$(git log --format=%B $range | "$text_check" --upstream-text); then
        printf 'pre-push: %s: commit messages name an agent, a model or a local path:\n%s\n' "$branch" "$named" >&2
        rejected=1
    fi
done
(( rejected == 0 )) || { echo 'Push refused: cut up/* branches from upstream/main, cherry-pick engine commits only, and drop agent trailers (git commit --amend).' >&2; exit 1; }
