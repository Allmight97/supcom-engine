#!/usr/bin/env bash
# Toolkit checks: script syntax, the tools' self-tests, the commit and push guards and Claude hooks, mac/scripts/setup,
# dead terms, and dead links in mac/README.md, AGENTS.md and docs/. Engine changes are
# proven by OpenSupCom's own tests (mac/docs/toolchain.md). Writes the result to mac/work/check-last.txt ("EPOCH pass"
# or "EPOCH fail COUNT"), and mac/work/check-last.manifest, the content the check started on (mac/scripts/tree-snapshot,
# paths relative to the checkout root), for the commit hook.
set -uo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
failures=0
fail() { printf 'FAIL: %s\n' "$1"; failures=$((failures + 1)); }
snapshot="$("$root/scripts/tree-snapshot" "$root")"
write_receipt() { # DIR SNAPSHOT RESULT [COUNT]: record that the content in SNAPSHOT got RESULT
    mkdir -p "$1/work"
    printf '%s\n' "$2" > "$1/work/check-last.manifest"
    echo "$(date +%s) $3${4:+ $4}" > "$1/work/check-last.txt"
}

syntax_checked=0
while IFS= read -r -d '' path; do
    script="$root/$path"
    [[ -f $script ]] || continue
    case "$path:$(head -c 40 "$script")" in
        *.py:*|*:'#!'*python3*) python3 -I -c 'import ast, sys; ast.parse(open(sys.argv[1]).read(), sys.argv[1])' "$script" \
                                    || fail "python syntax: $script" ;;
        *:'#!/bin/sh'*) sh -n "$script" || fail "shell syntax: $script" ;;
        *.sh:*|*:'#!'*bash*) bash -n "$script" || fail "shell syntax: $script" ;;
        *) continue ;;
    esac
    syntax_checked=$((syntax_checked + 1))
done < <(git -C "$root" ls-files -z --cached --others --exclude-standard -- scripts tools agents recipe)
(( syntax_checked > 0 )) || fail "syntax check found no scripts"

for tool in scripts/upstream-news scripts/sync-upstream scripts/prove scripts/up-refresh tools/lib/capture.py \
            tools/motion-compare/motion_compare.py tools/intel-compare/intel_compare.py tools/bp-dump/compare.py \
            tools/parity/parity tools/pulse/pulse scripts/mutate; do
    python3 -I "$root/$tool" --self-test >/dev/null || fail "self-test: python3 -I mac/$tool --self-test"
done

acquire_lock() {
    local lock=$1 owner
    until mkdir "$lock" 2>/dev/null; do
        owner=$(cat "$lock/pid" 2>/dev/null) || owner=
        if [[ -z $owner ]]; then
            sleep 1
            owner=$(cat "$lock/pid" 2>/dev/null) || owner=
        fi
        if [[ $owner =~ ^[0-9]+$ ]] && kill -0 "$owner" 2>/dev/null; then
            echo "Waiting for mac/scripts/check PID $owner in this checkout..." >&2
            sleep 1
        else
            echo "Removing stale mac/scripts/check lock (PID ${owner:-unknown})." >&2
            rm -f "$lock/pid"
            rmdir "$lock" 2>/dev/null || return 1
        fi
    done
    echo "$$" > "$lock/pid"
}
lock="$root/work/.check-lock"; mkdir -p "$root/work"
acquire_lock "$lock" || exit 1
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch" "$lock"' EXIT
mkdir "$scratch/dead-lock"; echo 2147483647 > "$scratch/dead-lock/pid"
acquire_lock "$scratch/dead-lock" 2> "$scratch/lock.log" || fail "check lock did not recover a dead PID"
mkdir "$scratch/ownerless-lock"
acquire_lock "$scratch/ownerless-lock" 2> "$scratch/ownerless.log" || fail "check lock did not recover a missing PID"
mkdir "$scratch/live-lock"; echo "$$" > "$scratch/live-lock/pid"
(acquire_lock "$scratch/live-lock" 2> "$scratch/live.log" && touch "$scratch/acquired") &
waiter=$!
sleep 0.2
[[ ! -e "$scratch/acquired" ]] || fail "check lock ignored a live PID"
rm "$scratch/live-lock/pid"; rmdir "$scratch/live-lock"
wait "$waiter" || fail "check lock did not acquire after its owner released it"
[[ -e "$scratch/acquired" ]] || fail "check lock waiter did not finish"
new_repo() { # DIR HOOKS: a scratch repository whose commits run the hooks in HOOKS
    git init -q "$1"
    git -C "$1" config user.email check@localhost
    git -C "$1" config user.name check
    [[ -z $2 ]] || git -C "$1" config core.hooksPath "$2"
}
expect_commit_in() { # REPO EXPECTED LABEL [COMMIT ARGS]
    local repo=$1 expected=$2 label=$3 actual
    shift 3
    if git -C "$repo" commit -qm "$label" "$@" >/dev/null 2>&1; then actual=allowed; else actual=rejected; fi
    [[ $actual == "$expected" ]] || fail "pre-commit $label: expected $expected, got $actual"
    [[ $actual == allowed ]] && git -C "$repo" reset -q --soft HEAD~ 2>/dev/null
    [[ -e "$(git -C "$repo" rev-parse --absolute-git-dir)/MERGE_HEAD" ]] || git -C "$repo" reset -q
}
expect_commit() { expect_commit_in "$scratch" "$@"; }

new_repo "$scratch" ""
head -c 1100000 /dev/zero > "$scratch/big.dat"; printf 'png' > "$scratch/icon.png"
echo text > "$scratch/notes.txt"
git -C "$scratch" add big.dat icon.png notes.txt; git -C "$scratch" commit -qm baseline
mkdir -p "$scratch/commit-hooks/claude"; cp "$root"/agents/githooks/{pre-commit,commit-msg} "$scratch/commit-hooks/"
cp "$root/agents/hooks/guard-shell" "$scratch/commit-hooks/claude/"; git -C "$scratch" config core.hooksPath "$scratch/commit-hooks"
echo text > "$scratch/plain.txt"; git -C "$scratch" add plain.txt; expect_commit allowed "plain text"; rm "$scratch/plain.txt"
echo more >> "$scratch/big.dat"; echo more >> "$scratch/icon.png"; git -C "$scratch" add big.dat icon.png
expect_commit allowed "edit of a tracked large file and image outside mac/"
git -C "$scratch" checkout -q -- big.dat icon.png
printf 'MZ\x90\x00' > "$scratch/tool.txt"; git -C "$scratch" add tool.txt; expect_commit rejected "executable header"
head -c 1100000 /dev/zero > "$scratch/big.txt"; git -C "$scratch" add big.txt; expect_commit rejected "new file over 1 MiB"
mkdir -p "$scratch/mac/work"; echo x > "$scratch/mac/work/n.txt"; git -C "$scratch" add mac/work; expect_commit rejected "mac/work directory"
rm -f "$scratch"/tool.txt "$scratch"/big.txt; rm -rf "$scratch/mac/work"
for name in gamedata.scd shot.PNG LastGame.oscreplay mac/SupCom.gpr; do
    echo x > "$scratch/$name"; git -C "$scratch" add "$name"; expect_commit rejected "new $name"; rm "$scratch/$name"
done
code_of() { { printf '%s' "$2"; head -c $(($3 - ${#2})) /dev/zero | tr '\0' x; } > "$scratch/$1"; git -C "$scratch" add "$1"; }
mkdir -p "$scratch/mac/tools"
code_of mac/tools/fits.py '' 32000; expect_commit allowed "toolkit code at the 8,000-token budget"
code_of mac/tools/big.lua '' 32001; expect_commit rejected "toolkit code over the budget"
code_of mac/tools/run '#!/bin/sh' 32001; expect_commit rejected "extensionless script over the budget"
code_of mac/tools/notes '' 32001; code_of mac/tools/fix.patch '' 32001; code_of big.py '' 32001
expect_commit allowed "data, patches and engine files over the toolkit code budget"
rm -rf "$scratch/mac/tools" "$scratch/big.py"

mkdir -p "$scratch/mac/scripts"; printf '#!/bin/sh\n' > "$scratch/mac/scripts/check"; chmod +x "$scratch/mac/scripts/check"
echo /work/ > "$scratch/mac/.gitignore"
receipt() { write_receipt "$scratch/mac" "$("$root/scripts/tree-snapshot" "$scratch/mac")" "$@"; }
git -C "$scratch" add mac/scripts/check mac/.gitignore; expect_commit rejected "toolkit commit before any check"
git -C "$scratch" add mac/scripts/check mac/.gitignore; receipt pass
git -C "$scratch" commit -qm toolkit >/dev/null 2>&1 \
    || fail "pre-commit nested toolkit: a receipt taken inside mac/ must name paths from the checkout root"
gate() { git -C "$scratch" add mac/gate.txt; }
echo text > "$scratch/mac/gate.txt"; gate; receipt pass; git -C "$scratch" commit -qm gate
gate; receipt pass; echo edited >> "$scratch/mac/gate.txt"; gate; expect_commit rejected "file edited after the check"
gate; receipt fail 1; expect_commit rejected "failed check"
gate; receipt pass; expect_commit allowed "fresh passing check"
gate; receipt pass; echo more >> "$scratch/notes.txt"; expect_commit allowed "unrelated tracked file edited after the check"
git -C "$scratch" checkout -q -- notes.txt
gate; receipt pass; echo again >> "$scratch/mac/gate.txt"; expect_commit rejected "path-limited commit of a file edited after the check" -- mac/gate.txt
gate; receipt pass; expect_commit allowed "path-limited commit of the checked file" -- mac/gate.txt
receipt pass; git -C "$scratch" rm -qf mac/gate.txt; expect_commit rejected "deletion after the check"
git -C "$scratch" add -u mac/gate.txt; receipt pass; expect_commit allowed "deletion the check saw"
git -C "$scratch" checkout -q HEAD -- mac/gate.txt
git -C "$scratch" checkout -q -b side; echo side > "$scratch/mac/side.txt"; git -C "$scratch" add mac/side.txt; receipt pass
git -C "$scratch" commit -qm side; git -C "$scratch" checkout -q -; receipt pass
git -C "$scratch" merge -q --no-ff --no-commit side >/dev/null
expect_commit rejected "merge commit before any check"; receipt pass; expect_commit allowed "merge commit after the check"
mkdir -p "$scratch/mac/tool"; echo a > "$scratch/mac/tool/run"; echo b > "$scratch/mac/tool/hook.lua"; git -C "$scratch" add mac/tool/run
receipt pass; expect_commit rejected "untracked file beside a committed one"
rm -rf "$scratch/mac/side.txt" "$scratch/mac/tool"
echo '@AGENTS.md' > "$scratch/CLAUDE.md"; git -C "$scratch" add CLAUDE.md
receipt fail 1; expect_commit rejected "root CLAUDE.md after a failed check"
git -C "$scratch" add CLAUDE.md; receipt pass; expect_commit allowed "root CLAUDE.md after a passing check"
rm "$scratch/CLAUDE.md"
echo code > "$scratch/engine.cpp"; git -C "$scratch" add engine.cpp
receipt fail 1; expect_commit allowed "engine commit needs no toolkit check"
git -C "$scratch" add engine.cpp
expect_commit rejected "engine commit naming an agent" -m "Co-Authored-By: Claude <noreply@anthropic.com>"
rm "$scratch/engine.cpp"; echo x > "$scratch/mac/toolkit.txt"; git -C "$scratch" add mac/toolkit.txt; receipt pass
expect_commit allowed "toolkit commit keeps its attribution" -m "Co-Authored-By: Claude <noreply@anthropic.com>"
rm "$scratch/mac/toolkit.txt"

push="$scratch/push"
new_repo "$push" ""
echo a > "$push/engine.cpp"; git -C "$push" add engine.cpp; git -C "$push" commit -qm base
git -C "$push" update-ref refs/remotes/upstream/main HEAD
git init -q --bare "$scratch/origin.git"; mkdir -p "$scratch/push-hooks/claude"
cp "$root/agents/githooks/pre-push" "$scratch/push-hooks/"; cp "$root/agents/hooks/guard-shell" "$scratch/push-hooks/claude/"
git -C "$push" config core.hooksPath "$scratch/push-hooks"
expect_push() { # EXPECTED LABEL BRANCH
    local actual
    if git -C "$push" push -q "$scratch/origin.git" "$3" >/dev/null 2>&1; then actual=allowed; else actual=rejected; fi
    [[ $actual == "$1" ]] || fail "pre-push $2: expected $1, got $actual"
}
git -C "$push" checkout -q -b up/engine; echo b >> "$push/engine.cpp"; git -C "$push" commit -qam engine
expect_push allowed "up/ branch with engine commits only" up/engine
git -C "$push" checkout -q -b up/carries-mac; mkdir "$push/mac"; echo x > "$push/mac/notes.md"
git -C "$push" add mac; git -C "$push" commit -qm toolkit; git -C "$push" rm -qr mac; git -C "$push" commit -qm "drop toolkit"
expect_push rejected "up/ branch whose history carries a mac/ commit" up/carries-mac
git -C "$push" checkout -q -b mac/side; expect_push allowed "fork branch with mac/ commits" mac/side
git -C "$push" checkout -q -b up/agents up/engine; echo x > "$push/AGENTS.md"; git -C "$push" add AGENTS.md
git -C "$push" commit -qm agents; expect_push rejected "up/ branch adding AGENTS.md" up/agents
git -C "$push" checkout -q -b up/nested up/engine; mkdir -p "$push/src"; echo x > "$push/src/AGENTS.md"
git -C "$push" add src; git -C "$push" commit -qm nested; expect_push rejected "up/ branch adding a nested AGENTS.md" up/nested
expect_push rejected "fork branch pushed to an up/ name" mac/side:up/renamed
git -C "$push" checkout -q -b up/named up/engine; echo c >> "$push/engine.cpp"
git -C "$push" commit -qam "engine fix" -m "Co-Authored-By: Claude <noreply@anthropic.com>"
expect_push rejected "up/ commit message naming an agent" up/named
git -C "$push" push -q --no-verify "$scratch/origin.git" up/named 2>/dev/null
echo d >> "$push/engine.cpp"; git -C "$push" commit -qam "engine follow-up"
expect_push allowed "up/ push whose named commit is already on the remote" up/named
rm -rf "$push" "$scratch/origin.git" "$scratch/push-hooks"

osc="$scratch/osc"
git init -q "$osc"; mkdir "$osc/.claude"
git -C "$osc" config remote.upstream.url https://example.invalid/upstream
echo '{"permissions": {"allow": ["Bash(ls)"]}, "enabledPlugins": {"other@test": true}, "extraKnownMarketplaces": {"other": {"source": {"source": "github", "repo": "example/other"}}}}' > "$osc/.claude/settings.local.json"
OSC_ROOT="$osc" "$root/scripts/setup" --check >/dev/null && fail "setup --check passed a checkout that is not set up"
OSC_ROOT="$osc" "$root/scripts/setup" >/dev/null || fail "setup failed on a fresh checkout"
OSC_ROOT="$osc" "$root/scripts/setup" --check >/dev/null || fail "setup --check failed right after setup"
[[ "$(OSC_ROOT="$osc" "$root/scripts/setup")" == *"set up."* ]] || fail "setup wrote again on a set-up checkout"
grep -q 'Bash(ls)' "$osc/.claude/settings.local.json" || fail "setup dropped other keys of settings.local.json"
[[ "$(grep -cx '/mac/work/' "$osc/.git/info/exclude")" == 1 ]] || fail "setup exclude lines"
python3 -I - "$root" "$osc" <<'PY' || fail "setup: hooks outside the tree, Claude settings, push URL"
import json
import os
import pathlib
import runpy
import shlex
import sys

root, osc = map(pathlib.Path, sys.argv[1:])
module = runpy.run_path(str(root / 'scripts/setup'))
settings = json.loads((osc / '.claude/settings.local.json').read_text())
hooks = (osc / '.git/mac-hooks').resolve()
start = settings['hooks']['SessionStart'][0]['hooks'][0]['command']
assert start.startswith('python3 -I ') and 'mac/tools/pulse/pulse' in start and '--brief' in start, start
assert settings['enabledPlugins']['other@test']
assert settings['enabledPlugins'][module['APPLE_PLUGIN']]
assert settings['extraKnownMarketplaces']['other']['source']['repo'] == 'example/other'
assert settings['extraKnownMarketplaces']['supcom']['source']['path'] == str(root / 'agents/mods')
for entry in settings['hooks']['PreToolUse']:
    for hook in entry['hooks']:
        path = pathlib.Path(shlex.split(hook['command'])[0])
        assert path.parent == hooks / 'claude' and os.access(path, os.X_OK), path
        assert path.read_bytes() == (root / 'agents/hooks' / path.name).read_bytes(), path
for name in ('pre-commit', 'commit-msg', 'pre-push'):
    assert (hooks / name).read_bytes() == (root / 'agents/githooks' / name).read_bytes(), name
assert module['git'](str(osc), 'config', 'core.hooksPath').stdout.strip() == str(hooks)
assert module['git'](str(osc), 'remote', 'get-url', '--push', 'upstream').stdout.strip() == 'DISABLED'
assert not (osc / 'AGENTS.md').exists() and not (osc / 'CLAUDE.md').exists()
PY
echo stale >> "$osc/.git/mac-hooks/pre-commit"
OSC_ROOT="$osc" "$root/scripts/setup" --check >/dev/null && fail "setup --check missed a stale hook copy"
mkdir -p "$osc/mac/scripts"; cp "$root/scripts/setup" "$osc/mac/scripts/"; cp -R "$root/agents" "$osc/mac/"
git -C "$osc" add mac; git -C "$osc" -c core.hooksPath=/dev/null -c user.name=t -c user.email=t@t commit -qm toolkit
git -C "$osc" worktree add -q "$scratch/osc-wt"
OSC_ROOT="$osc" "$osc/mac/scripts/setup" >/dev/null || fail "setup failed on a checkout holding mac/"
mkdir -p "$scratch/osc-wt/.claude"; cp "$osc/.claude/settings.local.json" "$scratch/osc-wt/.claude/"
"$scratch/osc-wt/mac/scripts/setup" --check >/dev/null \
    || fail "a worktree holding the main checkout's settings (.worktreeinclude) is not set up"
rm -rf "$osc" "$scratch/osc-wt"
"$root/scripts/setup" --check || fail "this checkout is not set up (run mac/scripts/setup)"

mkdir -p "$scratch/build/bin" "$scratch/recipe/osc" "$scratch/smoke/build/play"
cp "$root/recipe/"{build,env}.sh "$scratch/recipe/osc/"
printf '#!/bin/sh\n[ "$1" != --build ]\n' > "$scratch/build/bin/cmake"; chmod +x "$scratch/build/bin/cmake"
OSC_ROOT="$scratch/build" PATH="$scratch/build/bin:$PATH" bash "$scratch/recipe/osc/build.sh" > "$scratch/build-result" 2>&1
[[ $? == 1 && -d "$scratch/build/.local/tmp" ]] && grep -q BUILD_FAIL "$scratch/build-result" \
    || fail "build recipe must create temp directories and fail when compilation fails"
printf '#!/bin/sh\nexit 0\n' > "$scratch/build/bin/cmake"
OSC_ROOT="$scratch/build" PATH="$scratch/build/bin:$PATH" bash "$scratch/recipe/osc/build.sh" > "$scratch/build-result" 2>&1 \
    || fail "build recipe rejected a successful stub build"
for shell in bash zsh; do
    env -u OSC_FA_PATH "$shell" -c 'source "$1"; [[ $OSC_FA_PATH == "$2/work/game" ]]' test \
        "$scratch/recipe/osc/env.sh" "$scratch/recipe" || fail "env.sh default path in $shell"
    OSC_FA_PATH=/explicit/game "$shell" -c 'source "$1"; [[ $OSC_FA_PATH == /explicit/game ]]' test \
        "$scratch/recipe/osc/env.sh" || fail "env.sh explicit game path in $shell"
    env -u VULKAN_SDK -u VK_DRIVER_FILES "$shell" -c '
        source "$1"
        [[ $VULKAN_SDK == "$2"/work/vulkan-sdk/*/macOS && -z ${VK_DRIVER_FILES+x} ]]
    ' test "$scratch/recipe/osc/env.sh" "$scratch/recipe" || fail "env.sh SDK default in $shell"
    env -u VK_DRIVER_FILES VULKAN_SDK="/explicit/sdk path" "$shell" -c '
        source "$1"
        [[ $VULKAN_SDK == "/explicit/sdk path" && -z ${VK_DRIVER_FILES+x} ]]
    ' test "$scratch/recipe/osc/env.sh" || fail "env.sh explicit SDK in $shell"
done
cat > "$scratch/smoke/build/play/opensupcom" <<'SH'
#!/bin/sh
while [ "$1" != --log ]; do shift; done
printf '%s\n' "${SMOKE_LINE:-[info] clean}" > "$2"
exit "${SMOKE_EXIT:-0}"
SH
chmod +x "$scratch/smoke/build/play/opensupcom"
OSC_ROOT="$scratch/smoke" "$root/scripts/osc-smoke" > "$scratch/smoke-result" || fail "osc-smoke rejected clean stub output"
grep -q "$scratch/smoke/.local/mac-smoke.log" "$scratch/smoke-result" || fail "osc-smoke did not print its log path"
OSC_ROOT="$scratch/smoke" SMOKE_LINE='[error] injected' "$root/scripts/osc-smoke" >/dev/null 2>&1 \
    && fail "osc-smoke accepted an error line"
OSC_ROOT="$scratch/smoke" SMOKE_EXIT=7 "$root/scripts/osc-smoke" >/dev/null 2>&1 \
    && fail "osc-smoke accepted a non-zero exit"

cat > "$scratch/smoke/build/play/opensupcom" <<'SH'
#!/bin/sh
while [ "$1" != --log ]; do shift; done
if [ "${RENDER_NO_LOG:-0}" != 1 ]; then
    printf '%s\n' "${RENDER_LINE:-[info] Vulkan loader 1.4.363, driver KosmicKrisp (Mesa test), driverID 28}" > "$2"
fi
exit "${RENDER_EXIT:-0}"
SH
OSC_ROOT="$scratch/smoke" "$root/scripts/osc-render-check" > "$scratch/render-result" \
    || fail "osc-render-check rejected clean KosmicKrisp output"
grep -q "$scratch/smoke/.local/mac-render-check.log" "$scratch/render-result" \
    || fail "osc-render-check did not print its log path"
for line in '[info] Vulkan loader 1.4.363, driver MoltenVK (test), driverID 14' \
            '[info] KosmicKrisp mentioned elsewhere' \
            $'[info] Vulkan loader 1.4.363, driver KosmicKrisp (test), driverID 28\n[error] injected'; do
    OSC_ROOT="$scratch/smoke" RENDER_LINE="$line" "$root/scripts/osc-render-check" >/dev/null 2>&1 \
        && fail "osc-render-check accepted an invalid driver log or error line"
done
OSC_ROOT="$scratch/smoke" RENDER_EXIT=7 "$root/scripts/osc-render-check" >/dev/null 2>&1 \
    && fail "osc-render-check accepted a non-zero exit"
OSC_ROOT="$scratch/smoke" RENDER_NO_LOG=1 "$root/scripts/osc-render-check" >/dev/null 2>&1 \
    && fail "osc-render-check accepted a stale or missing log"

mkdir -p "$scratch/play/build/play"
printf '#!/bin/sh\nprintf "%%s\\n" "$@" > "$PLAY_ARGS"\n' > "$scratch/play/build/play/opensupcom"
chmod +x "$scratch/play/build/play/opensupcom"
play_args() { # FILE [PLAY ARGS]: the arguments the game got, one a line
    local file=$1; shift
    OSC_ROOT="$scratch/play" PLAY_ARGS="$file" "$root/scripts/play" "$@" >/dev/null 2>&1
    cat "$file"
}
play_args "$scratch/play/default" | grep -qx -- '--fps-cap\|--windowed\|--fullscreen' \
    && fail "play: by default the Video options decide (no window or frame-cap arguments)"
[[ $(play_args "$scratch/play/full" --full | grep -cx -- --fullscreen) == 1 ]] || fail "play: --full overrides full screen"

check_plugins() { # SOURCE INSTALLED_JSON PROJECT
    python3 -I - "$@" <<'PY'
import json
import pathlib
import sys

source, installed, project = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]), sys.argv[3]
if not installed.exists():
    print('Skipping the installed-plugin check: installed_plugins.json does not exist.')
    sys.exit(0)
records = json.loads(installed.read_text()).get('plugins', {})
problems = [f'{name} is installed but gone from mac/agents/mods (claude plugin uninstall {name} --scope local)'
            for name in records if name.endswith('@supcom') and not (source / name.removesuffix('@supcom')).is_dir()]
for plugin in sorted(d for d in source.iterdir() if (d / '.claude-plugin/plugin.json').is_file()):
    name = plugin.name + '@supcom'
    version = json.loads((plugin / '.claude-plugin/plugin.json').read_text())['version']
    mine = [r for r in records.get(name, []) if r.get('projectPath') == project]
    if not mine:
        problems.append(f'{name} is not installed for {project} (claude plugin install {name} --scope local)')
        continue
    cache = pathlib.Path(mine[0].get('installPath', ''))
    stale = [str(f.relative_to(plugin)) for f in plugin.rglob('*') if f.is_file()
             and not ((cache / f.relative_to(plugin)).is_file() and (cache / f.relative_to(plugin)).read_bytes() == f.read_bytes())]
    if mine[0].get('version') != version or stale:
        problems.append(f'{name} {mine[0].get("version")} differs from mac/agents/mods ({version}; {", ".join(stale[:3]) or "version"}): '
                        f'bump its plugin.json version if files changed, then from this checkout: claude plugin uninstall {name} --scope local '
                        f'&& claude plugin install {name} --scope local (update can pick another worktree\'s install)')
print('\n'.join(problems))
sys.exit(1 if problems else 0)
PY
}
plugins="$scratch/plugins"
mkdir -p "$plugins/source/demo/.claude-plugin" "$plugins/cache/demo/.claude-plugin"
echo '{"version": "1"}' | tee "$plugins/source/demo/.claude-plugin/plugin.json" > "$plugins/cache/demo/.claude-plugin/plugin.json"
printf '{"plugins":{"demo@supcom":[{"projectPath":"/p","version":"1","installPath":"%s"}]}}\n' "$plugins/cache/demo" > "$plugins/installed.json"
check_plugins "$plugins/source" "$plugins/absent.json" /p >/dev/null || fail "plugin check fresh machine"
check_plugins "$plugins/source" "$plugins/installed.json" /p >/dev/null || fail "plugin check installed copy equal to source"
check_plugins "$plugins/source" "$plugins/installed.json" /other >/dev/null && fail "plugin check missed a plugin installed only elsewhere"
echo edited > "$plugins/source/demo/skill.md"
check_plugins "$plugins/source" "$plugins/installed.json" /p >/dev/null && fail "plugin check missed a source edit"
rm -rf "$plugins/source/demo"
check_plugins "$plugins/source" "$plugins/installed.json" /p >/dev/null && fail "plugin check missed a removed plugin"
check_plugins "$root/agents/mods" "$HOME/.claude/plugins/installed_plugins.json" "$(dirname "$root")" || fail "installed supcom plugins match mac/agents/mods"

"$root/agents/hooks/test" || fail "Claude hook cases (mac/agents/hooks/test)"

printf "a = {\n    b = 'x}\\\\'{'\n}\nactive_mods = {\n    ['old-uid'] = true\n}\nmovie = { nologo = true }\n" > "$scratch/Game.prefs"
GAME_PREFS="$scratch/Game.prefs" "$root/scripts/game-prefs" mods >/dev/null || fail "game-prefs mods (clear)"
[[ "$(grep -c . "$scratch/Game.prefs")" == 5 ]] && grep -q "^active_mods = { }$" "$scratch/Game.prefs" \
    || fail "game-prefs did not replace a multi-line active_mods table"
printf "info: x\ninfo: Run time: 0h01m00s\n" > "$scratch/good.log"
printf "warning: SND: Error initializing 3D audio.\ninfo: Run time: 0h01m00s\n" > "$scratch/bad.log"
printf "warning: Unable to reset selection sets: call expected but got nil\n         stack traceback:\ninfo: Run time: 0h01m00s\n" > "$scratch/allow.log"
"$root/scripts/game-log-check" "$scratch/good.log" >/dev/null || fail "game-log-check rejected a clean log"
"$root/scripts/game-log-check" "$scratch/bad.log" >/dev/null && fail "game-log-check accepted a failing log"
"$root/scripts/game-log-check" "$scratch/good.log" --expect "absent" >/dev/null && fail "game-log-check ignored --expect"
"$root/scripts/game-log-check" "$scratch/allow.log" >/dev/null && fail "game-log-check accepted a Lua stack trace"
"$root/scripts/game-log-check" "$scratch/allow.log" --allow "Unable to reset selection sets" >/dev/null \
    || fail "game-log-check ignored --allow"

HOME="$scratch" "$root/scripts/game-window" key 36 >/dev/null 2>&1; code=$?
[[ $code == 4 ]] || fail "game-window sent input without JStar's grant (exit $code, expected 4)"
echo $(( $(date +%s) - 60 )) > "$scratch/.supcom-input-ok"
HOME="$scratch" "$root/scripts/game-window" key 36 >/dev/null 2>&1; code=$?
[[ $code == 4 ]] || fail "game-window sent input on an expired grant (exit $code, expected 4)"
rm -f "$scratch/.supcom-input-ok"


mkdir -p "$scratch/links/docs"
printf 'See [toolchain](toolchain.md), `mac/scripts/check`, `mac/tools/sim-capture/scripts/NAME.lua`, `mac/work/game` and `~/x/mac/none`.\n```\nmac/none\n```\n' \
    > "$scratch/links/docs/good.md"
cp "$root/docs/toolchain.md" "$scratch/links/docs/toolchain.md"
"$root/scripts/link-check" "$scratch/links/docs/good.md" >/dev/null || fail "link-check rejected live links"
printf 'See [gone](gone.md).\n' > "$scratch/links/bad1.md"
printf 'Run `mac/scripts/gone --x`.\n' > "$scratch/links/bad2.md"
"$root/scripts/link-check" "$scratch/links/bad1.md" >/dev/null && fail "link-check missed a dead Markdown link"
"$root/scripts/link-check" "$scratch/links/bad2.md" >/dev/null && fail "link-check missed a dead backticked path"
printf '[readme](docs/README.md) [gpu](docs/GPU-guide.md)\n' > "$scratch/links/uppercase.md"
"$root/scripts/link-check" "$scratch/links/uppercase.md" > "$scratch/links/uppercase.out"
[[ $? == 1 ]] && grep -q 'docs/README.md' "$scratch/links/uppercase.out" && grep -q 'docs/GPU-guide.md' "$scratch/links/uppercase.out" \
    || fail "link-check missed uppercase filenames"
printf '[template](docs/YYYY-MM-DD-TOPIC.md) [set](docs/SET-N.md)\n' > "$scratch/links/placeholders.md"
"$root/scripts/link-check" "$scratch/links/placeholders.md" >/dev/null || fail "link-check rejected explicit placeholder tokens"
"$root/scripts/doc-hygiene" || fail "dead terms in live guidance (mac/agents/dead-terms.txt)"
mapfile -t guidance < <(cd "$root" && git ls-files --cached --others --exclude-standard -- '*.md' ':!work' | sed "s|^|$root/|")
"$root/scripts/link-check" "$(dirname "$root")/AGENTS.md" "${guidance[@]}" || fail "dead links (mac/scripts/link-check)"

mkdir -p "$scratch/ghidra/bin"
printf '#!/bin/sh\necho ran\n' > "$scratch/ghidra/bin/uv"; chmod +x "$scratch/ghidra/bin/uv"
: > "$scratch/ghidra/SupCom.lock"
ghidra_py() { GHIDRA_LOCK="$scratch/ghidra/SupCom.lock" GHIDRA_HOLDER_PATTERN="holder-$$-token" GHIDRA_LOCK_WAIT=0 \
    PATH="$scratch/ghidra/bin:$PATH" "$root/scripts/ghidra-py" x 2>&1; }
[[ "$(ghidra_py)" == *ran* ]] || fail "ghidra-py waited on a lock file with no live holder"
perl -e 'sleep 60' "holder-$$-token" & holder=$!
sleep 1
[[ "$(ghidra_py)" == *ran* ]] && fail "ghidra-py ignored a live holder of the lock"
kill "$holder" 2>/dev/null; wait "$holder" 2>/dev/null


partial="/Users/x+y (z)/staging/timing-1/timing-1.log.partial"
pattern=$(bash -c '. "$1"; game_run_pattern "$2"' _ "$root/tools/lib/game-run.sh" "$partial")
grep -Eq "$pattern" <<< 'C:\cx\ForgedAlliance.exe /init Z:\a\init.lua /log Z:\Users\x+y (z)\staging\timing-1\timing-1.log.partial' \
    || fail "game-run kill pattern missed its own game"
grep -Eq "$pattern" <<< 'C:\cx\ForgedAlliance.exe /log Z:\Users\x+y (z)\staging\timing-2\timing-2.log.partial' \
    && fail "game-run kill pattern matched another run's game"


if (( failures )); then
    write_receipt "$root" "$snapshot" fail "$failures"
    printf '%d check(s) failed.\n' "$failures"
    exit 1
fi
write_receipt "$root" "$snapshot" pass
echo "All checks passed."
