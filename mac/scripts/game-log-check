#!/usr/bin/env python3
"""Check a GOG or FAF game log (/log FILE) for known failures; exit 1 if any is found.

  mac/scripts/game-log-check LOG [--expect TEXT ...] [--allow TEXT ...]

Prints one line per finding and the run time. A log without "Run time" means the
game did not exit normally (crash, kill, or still running). Each --expect TEXT must
appear somewhere in the log, for example "faf-autorun: saved". Lines containing an
--allow TEXT (and the stack-trace line after them) are not counted as failures, for
example the harmless FAF warning on loading a save: "Unable to reset selection sets".
"""
import re
import sys

FAILURES = [
    ("data path not found (y: drive or fa_path.lua)", re.compile(r'Search path element ".*" does not match any files')),
    ("Game.prefs not loaded", re.compile(r"Global Settings not loaded")),
    ("3D audio failed (missing sounds or XACT)", re.compile(r"SND: Error initializing 3D audio")),
    ("D3D9 device failed: primary_adapter is not a mode of the main display", re.compile(r"unable to create device")),
    ("Lua error", re.compile(r"Error running .*lua|stack traceback:|\.lua\(\d+\): ")),
    ("autorun failure", re.compile(r"faf-autorun: (error|save failed|load failed)")),
]


def main():
    args = sys.argv[1:]
    if not args or args[0].startswith("-"):
        sys.exit(__doc__.strip())
    path, rest = args[0], args[1:]
    expects, allows = [], []
    while rest:
        if rest[0] not in ("--expect", "--allow") or len(rest) < 2:
            sys.exit(__doc__.strip())
        (expects if rest[0] == "--expect" else allows).append(rest[1])
        rest = rest[2:]
    lines = open(path, errors="replace").read().splitlines()
    allowed = set()
    for n, line in enumerate(lines):
        if any(a in line for a in allows):
            allowed.update((n + 1, n + 2))
    found = 0
    for label, pattern in FAILURES:
        hits = [(n, line) for n, line in enumerate(lines, 1) if n not in allowed and pattern.search(line)]
        if hits:
            found += 1
            n, line = hits[0]
            print(f"FAIL {label}: {len(hits)} line(s), first at {n}: {line.strip()[:160]}")
    run_time = next((line.split("Run time:")[1].strip() for line in lines if "Run time:" in line), None)
    if run_time:
        print(f"ok   normal exit, run time {run_time}")
    else:
        found += 1
        print("FAIL no 'Run time' line: the game did not exit normally")
    text = "\n".join(lines)
    for expect in expects:
        if expect in text:
            print(f"ok   found: {expect}")
        else:
            found += 1
            print(f"FAIL missing: {expect}")
    sys.exit(1 if found else 0)


main()
