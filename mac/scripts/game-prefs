#!/usr/bin/env python3
"""Read and change the bottle's Game.prefs safely (shared by the GOG and FAF games).

  mac/scripts/game-prefs show                 print primary_adapter and active_mods
  mac/scripts/game-prefs adapter              set primary_adapter to the macOS main display (points, 60 Hz)
  mac/scripts/game-prefs mods [NAME ...]      set active_mods to these vault mods by name; no NAME clears it
GAME_PREFS=FILE selects another file (tests).

Changes refuse to run while a game is open (it rewrites the file on exit), back up the
file next to it as Game.prefs.bak-<time>, and check that braces stay balanced.
"""
import os
import re
import shutil
import subprocess
import sys
import time

BOTTLE = os.environ.get("FAF_BOTTLE", "SupCom")
PREFS = os.environ.get("GAME_PREFS") or os.path.expanduser(
    f"~/Library/Application Support/CrossOver/Bottles/{BOTTLE}/drive_c/users/crossover/"
    "AppData/Local/Gas Powered Games/Supreme Commander Forged Alliance/Game.prefs")
VAULT_MODS = os.path.expanduser("~/My Games/Gas Powered Games/Supreme Commander Forged Alliance/mods")


def die(message):
    sys.exit(f"game-prefs: {message}")


def brace_depths(text, start=0):
    """Yield (index, brace depth, open quote) per character; braces inside Lua strings do not count."""
    depth = 0
    quote = None
    escaped = False
    for i in range(start, len(text)):
        ch = text[i]
        if quote:
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == quote:
                quote = None
        elif ch in "'\"":
            quote = ch
        elif ch == "{":
            depth += 1
        elif ch == "}":
            depth -= 1
        yield i, depth, quote


def braces_balanced(text):
    depth, quote = 0, None
    for _, depth, quote in brace_depths(text):
        if depth < 0:
            return False
    return depth == 0 and quote is None


def top_level_span(text, key):
    match = re.search(rf"(?m)^{re.escape(key)} = ", text)
    if not match:
        return None
    start = match.end()
    if text[start] != "{":
        return match.start(), text.index("\n", start)
    for i, depth, _ in brace_depths(text, start):
        if depth == 0:
            return match.start(), i + 1
    die(f"unterminated table for {key}")


def game_running():
    result = subprocess.run(["pgrep", "-f", r"(ForgedAlliance|SupremeCommander)[.]exe"], capture_output=True)
    return result.returncode == 0


def write(text):
    if not os.environ.get("GAME_PREFS") and game_running():
        die("a game is running; close it first (it rewrites Game.prefs on exit)")
    if not braces_balanced(text):
        die("refusing to write: braces would be unbalanced")
    backup = f"{PREFS}.bak-{time.strftime('%Y%m%d-%H%M%S')}"
    n = 1
    while os.path.exists(backup):
        n += 1
        backup = f"{PREFS}.bak-{time.strftime('%Y%m%d-%H%M%S')}-{n}"
    shutil.copy2(PREFS, backup)
    with open(PREFS, "w") as f:
        f.write(text)
    print(f"backup: {backup}")


def main_display_points():
    script = "ObjC.import('AppKit'); var f = $.NSScreen.screens.objectAtIndex(0).frame; f.size.width + ',' + f.size.height"
    out = subprocess.run(["osascript", "-l", "JavaScript", "-e", script], capture_output=True, text=True, check=True)
    width, height = (int(float(v)) for v in out.stdout.strip().split(","))
    return width, height


def mod_uids(names):
    found = {}
    for entry in sorted(os.listdir(VAULT_MODS)) if os.path.isdir(VAULT_MODS) else []:
        info = os.path.join(VAULT_MODS, entry, "mod_info.lua")
        if not os.path.isfile(info):
            continue
        text = open(info, errors="replace").read()
        name = re.search(r'(?m)^name\s*=\s*"([^"]*)"', text)
        uid = re.search(r'(?m)^uid\s*=\s*"([^"]*)"', text)
        if name and uid:
            found[name.group(1).lower()] = uid.group(1)
    missing = [n for n in names if n.lower() not in found]
    if missing:
        die(f"not in {VAULT_MODS}: {', '.join(missing)} (installed: {', '.join(sorted(found)) or 'none'})")
    return [found[n.lower()] for n in names]


def main():
    if len(sys.argv) < 2 or sys.argv[1] not in ("show", "adapter", "mods"):
        die(__doc__.strip())
    text = open(PREFS).read()
    action = sys.argv[1]
    if action == "show":
        for line in re.findall(r"primary_adapter = '[^']*'", text):
            print(line)
        span = top_level_span(text, "active_mods")
        print(text[span[0]:span[1]] if span else "active_mods: absent")
    elif action == "adapter":
        width, height = main_display_points()
        value = f"'{width},{height},60'"
        text, count = re.subn(r"primary_adapter = '[^']*'", f"primary_adapter = {value}", text)
        if not count:
            die("no primary_adapter string in Game.prefs")
        write(text)
        print(f"primary_adapter = {value}")
    else:
        uids = mod_uids(sys.argv[2:])
        value = "{ " + ", ".join(f"['{u}'] = true" for u in uids) + " }" if uids else "{ }"
        span = top_level_span(text, "active_mods")
        line = f"active_mods = {value}"
        text = text[:span[0]] + line + text[span[1]:] if span else text.rstrip("\n") + "\n" + line + "\n"
        write(text)
        print(line)


main()
