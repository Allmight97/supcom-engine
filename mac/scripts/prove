#!/usr/bin/env python3
"""Run the engine checks an upstream PR needs and print a Markdown "Tested" block for its description.

  mac/scripts/prove [--root DIR] [--base REF]
  mac/scripts/prove --self-test

From the paths changed in BASE...HEAD of the tree at DIR (default: this checkout; BASE defaults to
upstream/main) it picks the checks: any change under src/, tests/, cmake/, third_party/, CMake files,
vcpkg.json or a shader runs unit, mp, gate (failures rerun once), format, metrics and smoke; a change
under src/renderer or to a shader adds the render check; anything else (docs) runs metrics only.
A C++ change (.cpp, .hpp, .h) under src/ or tests/ also runs tidy: clang-tidy 22 (from PyPI through uvx, with
the root's .clang-tidy and DIR/build/play) over the changed .cpp files and the .cpp files that include a changed
header, compared with tools/clang_tidy_baseline.txt through DIR's tools/clang_tidy_ratchet.py. A finding in
a changed file above its (path, check) baseline fails and is printed; an includer is analyzed only to reach
its changed headers (its own findings may be ones the Mac sees and Linux CI does not). Under `--base main`
(upstream's own changes, as sync-upstream proves them) tidy is skipped: upstream's CI checks them.
An engine change also runs `parity check --ratchet` (mac/tools/parity): OpenSupCom against the stored
captures of the original for each probe whose baseline matched; it is skipped, with a reason, when the
fork has no reference store or no gated probe. The probe sources are the stored, pinned ones; the build is
DIR's own.
It never builds: it stops if DIR/build/play is missing and notes a build older than HEAD. Exit status
is non-zero if any check fails or cannot run. Phases print as `prove: <phase>`; while a suite runs, a line
every 10 minutes gives elapsed minutes, CPU and memory of its process tree. The block prints last.
"""
import collections
import concurrent.futures
import contextlib
import fcntl
import importlib.util
import io
import json
import os
import re
import subprocess
import sys
import tempfile
import time

TOOLKIT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PARITY = f'{TOOLKIT}/tools/parity/parity'
ENGINE = ('src/', 'tests/', 'cmake/', 'third_party/')
ENGINE_FILES = ('CMakeLists.txt', 'CMakePresets.json', 'vcpkg.json')
SHADERS = ('.vert', '.frag', '.comp', '.geom', '.glsl', '.hlsl', '.slang')
TIDY_SOURCES = ('src/', 'tests/')
TIDY_SUFFIXES = ('.cpp', '.hpp', '.h')
UPSTREAMS_OWN = "the changes are upstream's own; its CI checks them"
HEARTBEAT_SECONDS = 600
ORDER = ['unit', 'mp', 'gate', 'format', 'tidy', 'metrics', 'smoke', 'parity', 'render']
ENGINE_SKIPS = {'render': 'no change under src/renderer or to a shader', 'tidy': 'no C++ change under src/ or tests/'}


def checks_for(paths):
    """(checks to run, {skipped check: reason})."""
    shader = any(p.endswith(SHADERS) for p in paths)
    engine = shader or any(p.startswith(ENGINE) or os.path.basename(p) in ENGINE_FILES
                           or p.endswith('.cmake') for p in paths)
    render = shader or any(p.startswith('src/renderer/') for p in paths)
    chosen = {'metrics'}
    if engine:
        chosen |= {'unit', 'mp', 'gate', 'format', 'smoke', 'parity'}
    if render:
        chosen.add('render')
    if any(p.startswith(TIDY_SOURCES) and p.endswith(TIDY_SUFFIXES) for p in paths):
        chosen.add('tidy')
    return [c for c in ORDER if c in chosen], {c: ENGINE_SKIPS[c] if engine else 'no engine change'
                                               for c in ORDER if c not in chosen}


def commands(base, root):
    """check name -> argv, run from the tree's root."""
    ctest = ['ctest', '--test-dir', 'build/play']
    return {
        'unit': ['build/play/tests/osc_tests'],
        'mp': ctest + ['-L', 'mp'],
        'gate': ctest + ['-L', 'gate', '-j', '4'],
        'format': ['sh', f'{TOOLKIT}/scripts/format', base],
        'metrics': ['python3', 'tools/status_metrics.py', 'check', '--build-dir', 'build/play'],
        'smoke': [f'{TOOLKIT}/scripts/osc-smoke'],
        'parity': ['python3', '-I', PARITY, 'check', '--ratchet', '--root', root],
        'render': [f'{TOOLKIT}/scripts/osc-render-check'],
    }


def parity_probes(root, env, refs=os.path.join(TOOLKIT, 'work', 'parity', 'refs'), parity=('python3', '-I', PARITY)):
    """(gated probes, why there are none, error): what `parity list --gated` says. Only an absent store or a
    successful, empty list skips the check; a failed listing is an error, never "nothing gated"."""
    if not os.path.isdir(refs):
        return [], 'this checkout has no reference store of the original game', ''
    listing = sh(root, [*parity, 'list', '--gated'], env)
    if listing.returncode:
        return [], '', (listing.stderr + listing.stdout).strip() or f'parity list exited {listing.returncode}'
    names = listing.stdout.split()
    return names, '' if names else 'no probe of the original game is gated yet', ''


def parity_line(names, passed, error=''):
    if error:
        return f'- the original-game parity probes: FAIL (cannot list the gated probes: {error.splitlines()[0]})'
    return f'- the original-game parity probes ({", ".join(names)}): {"match" if passed else "FAIL"}'


def tree_usage(ps_output, root):
    """(CPU percent, resident MB) of process ROOT and its descendants, from `ps -A -o pid=,ppid=,%cpu=,rss=`."""
    rows = {}
    for line in ps_output.splitlines():
        fields = line.split()
        if len(fields) == 4:
            rows[int(fields[0])] = (int(fields[1]), float(fields[2]), int(fields[3]))
    cpu = rss = 0
    for pid, (_, pid_cpu, pid_rss) in rows.items():
        ancestor = pid
        for _ in range(len(rows)):
            if ancestor == root or ancestor not in rows:
                break
            ancestor = rows[ancestor][0]
        if ancestor == root:
            cpu, rss = cpu + pid_cpu, rss + pid_rss
    return int(cpu), rss // 1024


def heartbeat_line(name, seconds, cpu, mb):
    return f'prove: {name}: {int(seconds // 60)} min elapsed, CPU {cpu}%, memory {mb} MB'


def sh(root, argv, env=None, beat=None, interval=HEARTBEAT_SECONDS):
    """Run argv in root, capturing output; with BEAT (a check name), print a heartbeat line every INTERVAL seconds."""
    proc = subprocess.Popen(argv, cwd=root, text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
    started = time.monotonic()
    while True:
        try:
            out, err = proc.communicate(timeout=interval if beat else None)
            return subprocess.CompletedProcess(argv, proc.returncode, out, err)
        except subprocess.TimeoutExpired:
            ps = subprocess.run(['ps', '-A', '-o', 'pid=,ppid=,%cpu=,rss='], text=True, capture_output=True).stdout
            print(heartbeat_line(beat, time.monotonic() - started, *tree_usage(ps, proc.pid)), flush=True)


def recipe_env(root):
    """The environment env.sh gives a build: without OSC_FA_PATH the engine reads FAF's files and data tests fail."""
    out = sh(root, ['bash', '-c', f'source {TOOLKIT}/recipe/env.sh && env -0']).stdout
    return {**dict(line.split('=', 1) for line in out.split('\0') if '=' in line), 'OSC_ROOT': root}


def run_check(root, name, argv, env):
    if name in ('unit', 'mp', 'gate'):
        # One tree at a time: parallel suites on one Mac fail network and render tests under load
        # (the unit tests include LAN lobby waits).
        with open(os.path.expanduser('~/.cache/osc-prove.lock'), 'w') as lock:
            print(f'prove: {name}: waiting for other trees\' heavy checks', flush=True)
            fcntl.flock(lock, fcntl.LOCK_EX)
            return run_suite(root, name, argv, env)
    return run_suite(root, name, argv, env)


def run_suite(root, name, argv, env):
    result = sh(root, argv, env, beat=name)
    if result.returncode and name in ('mp', 'gate'):
        print(f'prove: {name}: rerunning failures once (network tests flake under load)', flush=True)
        result = sh(root, ['ctest', '--test-dir', 'build/play', '--rerun-failed', '--output-on-failure'], env, beat=name)
    if result.returncode:
        print('\n'.join((result.stdout + result.stderr).strip().splitlines()[-20:]), flush=True)
    return result.returncode == 0


def load_ratchet(root):
    """The tree's own tools/clang_tidy_ratchet.py as a module: its baseline reader, finding pattern and paths."""
    spec = importlib.util.spec_from_file_location('clang_tidy_ratchet', f'{root}/tools/clang_tidy_ratchet.py')
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def tidy_sources(root, paths, compiled):
    """Changed .cpp files, and the .cpp files that include a changed header, that build/play compiles."""
    cpp = {p for p in paths if p.endswith('.cpp')}
    for header in (p for p in paths if p.endswith(('.hpp', '.h'))):
        include = rf'#include[[:space:]]+"([^"]*/)?{re.escape(os.path.basename(header))}"'
        cpp |= set(sh(root, ['git', 'grep', '-l', '-E', include, '--', *(f'{d}*.cpp' for d in TIDY_SOURCES)]).stdout.split())
    return sorted(cpp & compiled)


def tidy_scope(paths):
    return {p for p in paths if p.endswith(TIDY_SUFFIXES)}


def compiled_sources(root):
    with open(f'{root}/build/play/compile_commands.json') as f:
        entries = json.load(f)
    return {os.path.relpath(os.path.normpath(os.path.join(e['directory'], e['file'])), root) for e in entries}


def tidy_findings(output, root, warning):
    """{(path, check): [finding lines]}: each finding once, however many files include its header."""
    seen, found = set(), collections.defaultdict(list)
    for line in output.splitlines():
        match = warning.match(line.strip())
        if match:
            path = os.path.relpath(os.path.normpath(match['path']), root)
            where = (path, match['line'], match['col'], match['check'])
            if where not in seen:
                seen.add(where)
                found[(path, match['check'])].append(line.strip())
    return found


def tidy_worse(found, baseline, scope):
    """{(path, check): (baseline count, now)} for the findings in SCOPE above their baseline."""
    return {key: (baseline[key], len(lines)) for key, lines in found.items()
            if key[0] in scope and len(lines) > baseline[key]}


def tidy_tool(root):
    """(clang-tidy path, its major.minor version, error)."""
    code = "import clang_tidy, os; print(os.path.join(os.path.dirname(clang_tidy.__file__), 'data', 'bin', 'clang-tidy'))"
    found = sh(root, ['uvx', '-q', '--from', 'clang-tidy>=22,<23', 'python', '-c', code])
    path = found.stdout.strip()
    if found.returncode or not path:
        return '', '', found.stderr.strip() or 'uvx gave no clang-tidy path'
    return path, re.search(r'version (\d+\.\d+)', sh(root, [path, '--version']).stdout)[1], ''


def run_tidy(root, paths):
    """(passed, the Tested line)."""
    ratchet = load_ratchet(root)
    sources = tidy_sources(root, paths, compiled_sources(root))
    if not sources:
        return True, '- clang-tidy: no changed or affected source file is in build/play'
    tool, version, error = tidy_tool(root)
    sdk = sh(root, ['xcrun', '--show-sdk-path']).stdout.strip()
    if error or not sdk:
        print(f'prove: tidy: cannot find clang-tidy 22 or the SDK: {error or "xcrun gave no SDK path"}', flush=True)
        return False, '- clang-tidy: FAIL (cannot find clang-tidy 22 or the SDK)'
    argv = [tool, '-p', 'build/play', '--quiet', '--extra-arg=-isysroot', f'--extra-arg={sdk}']
    with concurrent.futures.ThreadPoolExecutor(os.cpu_count() or 4) as pool:
        runs = list(pool.map(lambda source: sh(root, [*argv, source]), sources))
    shown = f'- clang-tidy {version} on {len(sources)} source files against tools/clang_tidy_baseline.txt'
    failed = [(s, r) for s, r in zip(sources, runs) if r.returncode]
    for source, run in failed:
        print(f'prove: tidy: {source}: clang-tidy exited {run.returncode}; it did not analyze the file', flush=True)
        print('\n'.join((run.stdout + run.stderr).strip().splitlines()[-20:]), flush=True)
    found = tidy_findings('\n'.join(r.stdout + r.stderr for r in runs), root, ratchet.WARNING)
    worse = tidy_worse(found, ratchet.read_baseline()[1], tidy_scope(paths))
    for (path, check), (was, now) in sorted(worse.items()):
        print(f'NEW  {path} [{check}]: {was} -> {now}', flush=True)
        print('\n'.join(found[(path, check)]), flush=True)
    return not failed and not worse, shown + (': FAIL' if failed or worse else ': pass')


def main():
    args = sys.argv[1:]
    if '--self-test' in args:
        return self_test()
    opt = dict(zip(args[::2], args[1::2]))
    root = os.path.abspath(opt.get('--root', os.path.dirname(TOOLKIT)))
    base = opt.get('--base', 'upstream/main')
    diff = sh(root, ['git', 'diff', '--name-only', f'{base}...HEAD'])
    if diff.returncode:
        sys.exit(f'prove: cannot diff {base}...HEAD in {root}: {diff.stderr.strip()}')
    changed = diff.stdout.split()
    chosen, skipped = checks_for(changed)
    if base == 'main' and 'tidy' in chosen:
        chosen.remove('tidy')
        skipped['tidy'] = UPSTREAMS_OWN
    print(f'prove: {len(diff.stdout.split())} changed paths; checks: {" ".join(chosen)}', flush=True)
    cmds = commands(base, root)
    env = recipe_env(root)
    gated, parity_error = [], ''
    if 'parity' in chosen:
        gated, why, parity_error = parity_probes(root, env)
        if not gated and not parity_error:
            chosen.remove('parity')
            skipped['parity'] = why
    if not os.path.isdir(os.path.join(root, 'mac')):
        # Upstream's code finds a driver only in ~/VulkanSDK or Homebrew; name the fork's pinned KosmicKrisp.
        env['VK_ADD_DRIVER_FILES'] = f"{env['VULKAN_SDK']}/share/vulkan/icd.d/libkosmickrisp_icd.json"
    binary = os.path.join(root, 'build/play/opensupcom')
    notes = []
    if not os.path.exists(binary):
        sys.exit(f'prove: {binary} is missing; build the tree first (OSC_ROOT={root} bash mac/recipe/build.sh)')
    head_time = int(sh(root, ['git', 'log', '-1', '--format=%ct']).stdout.strip() or 0)
    if os.path.getmtime(binary) < head_time:
        notes.append('the build in build/play is older than HEAD; the results may not describe HEAD')
        print(f'prove: warning: {notes[-1]}', flush=True)
    results = {}
    for name in chosen:
        print(f'prove: check {name}', flush=True)
        if name == 'parity' and parity_error:
            print(parity_error, flush=True)
        if name == 'tidy':
            results[name], shown_tidy = run_tidy(root, changed)
        else:
            results[name] = False if name == 'parity' and parity_error else run_check(root, name, cmds[name], env)
        print(f'prove: check {name}: {"pass" if results[name] else "FAIL"}', flush=True)
    print(f'\n### Tested\n\nBase `{base}`, tree `{root}`.\n')
    for name in chosen:
        if name == 'parity':
            print(parity_line(gated, results[name], parity_error))
            continue
        if name == 'tidy':
            print(shown_tidy)
            continue
        shown = f'mac/scripts/format {base}' if name == 'format' else \
            ' '.join(cmds[name]).replace(f'{TOOLKIT}/scripts', 'mac/scripts')
        print(f'- `{shown}`: {"pass" if results[name] else "FAIL"}')
    for name, why in skipped.items():
        print(f'- skipped {name}: {why}')
    for note in notes:
        print(f'- note: {note}')
    sys.exit(0 if all(results.values()) else 1)


def tidy_self_test():
    compiled = {'src/a/x.cpp', 'src/a/y.cpp', 'src/b/z.cpp', 'tests/t.cpp'}
    with tempfile.TemporaryDirectory() as tree:
        git = ['git', '-C', tree]
        subprocess.run([*git, 'init', '-q'], check=True)
        for name, text in (('src/a/x.cpp', '#include "b/h.hpp"\n'), ('src/a/y.cpp', '#include "h.hpp"\n'),
                           ('src/b/z.cpp', '#include "other.hpp"\n'), ('tests/t.cpp', '#include "src/b/xh.hpp"\n'),
                           ('src/b/h.hpp', ''), ('src/b/other.hpp', '')):
            os.makedirs(os.path.dirname(f'{tree}/{name}'), exist_ok=True)
            with open(f'{tree}/{name}', 'w') as f:
                f.write(text)
        subprocess.run([*git, 'add', '--', 'src', 'tests'], check=True)
        assert tidy_sources(tree, ['src/b/z.cpp'], compiled) == ['src/b/z.cpp']
        assert tidy_sources(tree, ['src/b/h.hpp'], compiled) == ['src/a/x.cpp', 'src/a/y.cpp']
        assert tidy_sources(tree, ['src/b/h.hpp', 'src/b/z.cpp', 'tests/t.cpp'], compiled) == \
            ['src/a/x.cpp', 'src/a/y.cpp', 'src/b/z.cpp', 'tests/t.cpp']
        assert tidy_sources(tree, ['src/b/h.hpp', 'src/gone.cpp'], compiled) == ['src/a/x.cpp', 'src/a/y.cpp']
        assert tidy_sources(tree, ['src/b/unused.hpp'], compiled) == []
    warning = re.compile(r'^(?P<path>[^:\s]+):(?P<line>\d+):(?P<col>\d+): warning: .* \[(?P<check>[\w.,-]+)\]$')
    root = '/r'
    output = '\n'.join([
        '/r/src/a/../b/h.hpp:4:3: warning: use nullptr [modernize-use-nullptr]',
        '/r/src/a/../b/h.hpp:4:3: warning: use nullptr [modernize-use-nullptr]',
        '/r/src/b/h.hpp:9:1: warning: use nullptr [modernize-use-nullptr]',
        '/r/src/a/x.cpp:7:2: warning: sorting pointers [bugprone-nondeterministic-pointer-iteration-order]',
        '/r/src/a/x.cpp:7:2: error: not a warning [clang-diagnostic-error]',
        '   4 | not a finding line'])
    found = tidy_findings(output, root, warning)
    assert {k: len(v) for k, v in found.items()} == {('src/b/h.hpp', 'modernize-use-nullptr'): 2,
                                                     ('src/a/x.cpp', 'bugprone-nondeterministic-pointer-iteration-order'): 1}, found
    baseline = collections.Counter({('src/b/h.hpp', 'modernize-use-nullptr'): 2})
    assert tidy_worse(found, baseline, tidy_scope(['src/b/h.hpp'])) == {}, 'an includer\'s own finding is not this change\'s'
    scope = tidy_scope(['src/b/h.hpp', 'src/a/x.cpp'])
    assert tidy_worse(found, baseline, scope) == {('src/a/x.cpp', 'bugprone-nondeterministic-pointer-iteration-order'): (0, 1)}
    assert tidy_worse(found, baseline, {'src/b/h.hpp'}) == {}, 'a finding outside the changed files is not this change\'s'
    baseline[('src/b/h.hpp', 'modernize-use-nullptr')] = 1
    assert tidy_worse(found, baseline, {'src/b/h.hpp'}) == {('src/b/h.hpp', 'modernize-use-nullptr'): (1, 2)}
    baseline[('src/b/h.hpp', 'modernize-use-nullptr')] = 5
    assert tidy_worse(found, baseline, scope) != {} and ('src/b/h.hpp', 'modernize-use-nullptr') not in tidy_worse(found, baseline, scope)


def heartbeat_self_test():
    ps = '\n'.join(['1 0 0.0 100', '10 1 5.5 2048', '11 10 40.0 10240', '12 11 20.4 1048576', '13 1 99.0 99999', '14 14 1.0 1'])
    assert tree_usage(ps, 10) == (65, 1036), tree_usage(ps, 10)
    assert tree_usage(ps, 99) == (0, 0)
    assert heartbeat_line('gate', 1260, 65, 1036) == 'prove: gate: 21 min elapsed, CPU 65%, memory 1036 MB'
    log = io.StringIO()
    with contextlib.redirect_stdout(log):
        done = sh('.', ['sh', '-c', 'sleep 1; echo finished'], beat='unit', interval=0.3)
        quiet = sh('.', ['sh', '-c', 'echo quick'], beat='unit', interval=5)
    lines = log.getvalue().splitlines()
    assert done.stdout == 'finished\n' and done.returncode == 0 and quiet.stdout == 'quick\n', (done, quiet)
    assert len(lines) >= 2 and all(re.fullmatch(r'prove: unit: 0 min elapsed, CPU \d+%, memory \d+ MB', x) for x in lines), lines


def self_test():
    assert checks_for(['docs/a.md', 'README.md'])[0] == ['metrics']
    assert checks_for(['src/sim/a.cpp'])[0] == ['unit', 'mp', 'gate', 'format', 'tidy', 'metrics', 'smoke', 'parity']
    assert checks_for(['src/renderer/a.cpp'])[0] == ORDER
    assert checks_for(['src/app/a.cpp'])[1] == {'render': 'no change under src/renderer or to a shader'}
    assert checks_for(['assets/x.frag'])[0] == [c for c in ORDER if c != 'tidy']
    assert checks_for(['assets/x.frag'])[1] == {'tidy': 'no C++ change under src/ or tests/'}
    assert 'tidy' in checks_for(['tests/sim/a_test.cpp'])[0] and 'tidy' in checks_for(['src/sim/a.hpp'])[0]
    assert 'tidy' in checks_for(['src/sim/a.h'])[0]
    for path in ('src/app/mac_window.mm', 'src/app/notes.md', 'CMakeLists.txt', 'cmake/a.cmake', 'third_party/x/a.cpp'):
        assert 'tidy' not in checks_for([path])[0], path
    assert checks_for(['CMakeLists.txt'])[1]['tidy'] == 'no C++ change under src/ or tests/'
    assert checks_for(['docs/a.md'])[1]['tidy'] == 'no engine change'
    assert checks_for(['srcs/a.cpp', 'mac/scripts/x'])[0] == ['metrics']
    assert commands('upstream/main', '/up')['parity'][-3:] == ['--ratchet', '--root', '/up']
    line = parity_line(['timing', 'crowd'], True)
    assert line == '- the original-game parity probes (timing, crowd): match', line
    assert not any(part in parity_line(['timing'], False) for part in ('mac/work', 'mac/tools', TOOLKIT))
    with tempfile.TemporaryDirectory() as empty:
        names, why, error = parity_probes(empty, {}, os.path.join(empty, 'refs'))
        assert names == [] and 'reference store' in why and not error
        os.makedirs(os.path.join(empty, 'refs'))
        stubs = {}
        for stub, body in (('crash', 'exit 1'), ('noisy', 'echo "timing: DAMAGED run" >&2; exit 1'), ('none', 'exit 0'),
                           ('gated', 'echo timing; echo crowd')):
            stubs[stub] = os.path.join(empty, stub)
            with open(stubs[stub], 'w') as f:
                f.write(f'#!/bin/sh\n{body}\n')
        listed = {s: parity_probes(empty, {}, os.path.join(empty, 'refs'), parity=['sh', stubs[s]]) for s in stubs}
        assert listed['gated'] == (['timing', 'crowd'], '', ''), listed['gated']
        assert listed['none'][:2] == ([], 'no probe of the original game is gated yet') and not listed['none'][2], listed['none']
        assert listed['crash'][0] == [] and listed['crash'][2], f'a failed listing with empty output is an error: {listed["crash"]}'
        assert 'DAMAGED' in listed['noisy'][2], listed['noisy']
        assert 'FAIL' in parity_line([], False, listed['noisy'][2]) and 'DAMAGED' in parity_line([], False, listed['noisy'][2])
    tidy_self_test()
    heartbeat_self_test()
    print('prove self-test passed')


if __name__ == '__main__':
    main()
