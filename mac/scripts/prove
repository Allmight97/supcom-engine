#!/usr/bin/env python3
"""Run the engine checks an upstream PR needs and print a Markdown "Tested" block for its description.

  mac/scripts/prove [--root DIR] [--base REF] [--fail-first [--fail-first-against REF]]
  mac/scripts/prove --self-test

From the paths changed in BASE...HEAD of the tree at DIR (default: this checkout; BASE defaults to
upstream/main) it picks the checks: any change under src/, tests/, cmake/, third_party/, CMake files,
vcpkg.json or a shader runs unit, arch, mp, gate (failures rerun once), format, metrics and smoke; a change
under src/renderer or to a shader adds the render check; a change under tools/ runs arch and metrics;
anything else (docs) runs metrics only.
A suite passes only if tests ran: none found, none passed, or more skipped than passed (a gate with no
game: 3 passed, 274 skipped) is a failure, and the Tested block gives passed and skipped per suite.
--fail-first adds mac/scripts/mutate's base and sweep runs (the branch's tests alone on the base, each
source hunk reverted alone; --fail-first-against names the base's commit for a test-only branch) under
"Fail first" in the block. It never builds: it stops if DIR/build/play is missing or was
built from another revision than the tree's (`git describe --always --dirty`, as the build embeds it).
Exit status is non-zero if any check fails or cannot run. Phases print as `prove: <phase>`; the block prints last.
"""
import argparse
import fcntl
import os
import re
import subprocess
import sys

TOOLKIT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ENGINE = ('src/', 'tests/', 'cmake/', 'third_party/')
ENGINE_FILES = ('CMakeLists.txt', 'CMakePresets.json', 'vcpkg.json')
SHADERS = ('.vert', '.frag', '.comp', '.geom', '.glsl', '.hlsl', '.slang')
ORDER = ['unit', 'arch', 'mp', 'gate', 'format', 'metrics', 'smoke', 'render']
SUITES = ('unit', 'arch', 'mp', 'gate')
REVISION_HEADER = 'build/play/src/core/generated/osc_revision.hpp'


def checks_for(paths):
    """(checks to run, {skipped check: reason})."""
    shader = any(p.endswith(SHADERS) for p in paths)
    engine = shader or any(p.startswith(ENGINE) or os.path.basename(p) in ENGINE_FILES
                           or p.endswith('.cmake') for p in paths)
    render = shader or any(p.startswith('src/renderer/') for p in paths)
    chosen = {'metrics'} | ({'arch'} if any(p.startswith('tools/') for p in paths) else set())
    if engine:
        chosen |= {'unit', 'arch', 'mp', 'gate', 'format', 'smoke'}
    if render:
        chosen.add('render')
    why = 'no engine change' if not engine else 'no change under src/renderer or to a shader'
    return [c for c in ORDER if c in chosen], {c: why for c in ORDER if c not in chosen}


def commands(base):
    """check name -> argv, run from the tree's root."""
    ctest = ['ctest', '--test-dir', 'build/play', '--no-tests=error']
    return {
        'unit': ['build/play/tests/osc_tests'],
        'arch': ctest + ['-L', 'arch'],
        'mp': ctest + ['-L', 'mp'],
        'gate': ctest + ['-L', 'gate', '-j', '4'],
        'format': ['sh', f'{TOOLKIT}/scripts/format', base],
        'metrics': ['python3', 'tools/status_metrics.py', 'check', '--build-dir', 'build/play'],
        'smoke': [f'{TOOLKIT}/scripts/osc-smoke'],
        'render': [f'{TOOLKIT}/scripts/osc-render-check'],
    }


def ctest_counts(out):
    """(total, failed, not run) from a ctest run's summary; None when it has no summary (no tests found)."""
    m = re.search(r'^\d+% tests passed(?:, (\d+) tests? failed)? out of (\d+)', out, re.M)
    if not m:
        return None
    not_run = len(re.findall(r'^\s*\d+ - \S+ \((?:Skipped|Not Run|Disabled)\)\s*$', out, re.M))
    return int(m.group(2)), int(m.group(1) or 0), not_run


def catch2_counts(out):
    """(total, failed, skipped) test cases from a Catch2 run's summary; None when it has none."""
    if m := re.search(r'^All tests passed \(\d+ assertions? in (\d+) test cases?\)', out, re.M):
        return int(m.group(1)), 0, 0
    if m := re.search(r'^test cases:\s*(\d+)(.*)$', out, re.M):
        part = lambda word: int(n.group(1)) if (n := re.search(rf'(\d+) {word}', m.group(2))) else 0
        return int(m.group(1)), part('failed'), part('skipped')
    return (0, 0, 0) if re.search(r'^No tests ran', out, re.M) else None


def verdict(code, counts):
    """(passed?, detail for the Tested line) for a suite's exit code and (total, failed, skipped)."""
    if counts is None:
        return False, 'no tests found'
    total, failed, skipped = counts
    passed = total - failed - skipped
    detail = f'{passed} passed, {skipped} skipped, {failed} failed of {total}'
    if total == 0 or passed == 0:
        return False, f'nothing ran ({detail})'
    if skipped > passed:
        return False, f'mostly skipped ({detail})'
    return code == 0 and failed == 0, detail


def sh(root, argv, env=None):
    return subprocess.run(argv, cwd=root, text=True, capture_output=True, env=env)


def recipe_env(root):
    """The environment env.sh gives a build: without OSC_FA_PATH the engine reads FAF's files and data tests fail."""
    out = sh(root, ['bash', '-c', f'source {TOOLKIT}/recipe/env.sh && env -0']).stdout
    return {**dict(line.split('=', 1) for line in out.split('\0') if '=' in line), 'OSC_ROOT': root}


def tree_env(root):
    env = recipe_env(root)
    if not os.path.isdir(os.path.join(root, 'mac')):
        # Upstream's code finds a driver only in ~/VulkanSDK or Homebrew; name the fork's pinned KosmicKrisp.
        env['VK_ADD_DRIVER_FILES'] = f"{env['VULKAN_SDK']}/share/vulkan/icd.d/libkosmickrisp_icd.json"
    return env


def fail_first(root, mode, base):
    """(passed?, report lines) of mac/scripts/mutate MODE, its progress echoed as it runs."""
    run = subprocess.Popen([sys.executable, f'{TOOLKIT}/scripts/mutate', mode, '--root', root, '--base', base],
                           text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    lines = []
    for line in run.stdout:
        if line.startswith('mutate: '):
            print(f'prove: {line[8:]}', end='', flush=True)
        else:
            lines.append(line.rstrip('\n'))
    return run.wait() == 0, lines


def run_check(root, name, argv, env):
    """(passed?, detail or '')."""
    if name in ('unit', 'mp', 'gate'):
        # One tree at a time: parallel suites on one Mac fail network and render tests under load
        # (the unit tests include LAN lobby waits).
        with open(os.path.expanduser('~/.cache/osc-prove.lock'), 'w') as lock:
            print(f'prove: {name}: waiting for other trees\' heavy checks', flush=True)
            fcntl.flock(lock, fcntl.LOCK_EX)
            return run_suite(root, name, argv, env)
    return run_suite(root, name, argv, env)


def run_suite(root, name, argv, env):
    result = sh(root, argv, env)
    out = result.stdout + result.stderr
    counts = catch2_counts(out) if name == 'unit' else ctest_counts(out) if name in SUITES else None
    if result.returncode and name in ('mp', 'gate') and counts and counts[1]:
        print(f'prove: {name}: rerunning failures once (network tests flake under load)', flush=True)
        result = sh(root, ['ctest', '--test-dir', 'build/play', '--rerun-failed', '--output-on-failure'], env)
        rerun = ctest_counts(result.stdout + result.stderr)
        counts = (counts[0], rerun[1] if rerun else counts[1], counts[2])
        out = result.stdout + result.stderr
    ok, detail = verdict(result.returncode, counts) if name in SUITES else (result.returncode == 0, '')
    if not ok:
        print('\n'.join(out.strip().splitlines()[-20:]), flush=True)
    return ok, detail


def built_revision(root):
    """The revision build/play was built from, or None."""
    try:
        m = re.search(r'OSC_REVISION "([^"]*)"', open(os.path.join(root, REVISION_HEADER)).read())
    except OSError:
        return None
    return m and m.group(1)


def main():
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument('--root', default=os.path.dirname(TOOLKIT))
    parser.add_argument('--base', default='upstream/main')
    parser.add_argument('--fail-first', action='store_true')
    parser.add_argument('--fail-first-against')
    parser.add_argument('--self-test', action='store_true')
    opt = parser.parse_args()
    if opt.self_test:
        return self_test()
    root, base = os.path.abspath(opt.root), opt.base
    diff = sh(root, ['git', 'diff', '--name-only', f'{base}...HEAD'])
    if diff.returncode:
        sys.exit(f'prove: cannot diff {base}...HEAD in {root}: {diff.stderr.strip()}')
    chosen, skipped = checks_for(diff.stdout.split())
    print(f'prove: {len(diff.stdout.split())} changed paths; checks: {" ".join(chosen)}', flush=True)
    cmds = commands(base)
    env = tree_env(root)
    if not os.path.exists(os.path.join(root, 'build/play/opensupcom')):
        sys.exit(f'prove: build/play/opensupcom is missing in {root}; build the tree first '
                 f'(OSC_ROOT={root} bash mac/recipe/build.sh)')
    built = built_revision(root)
    tree = sh(root, ['git', 'describe', '--always', '--dirty']).stdout.strip()
    if built != tree:
        sys.exit(f'prove: build/play was built from {built or "an unknown revision"}, the tree is {tree}; '
                 f'rebuild first (cmake --build build/play in {root})')
    results = {}
    for name in chosen:
        print(f'prove: check {name}', flush=True)
        results[name] = run_check(root, name, cmds[name], env)
        print(f'prove: check {name}: {"pass" if results[name][0] else "FAIL"} {results[name][1]}'.rstrip(), flush=True)
    found = []
    if opt.fail_first:
        for mode, against in (('base', opt.fail_first_against or base), ('sweep', base)):
            print(f'prove: fail-first {mode}', flush=True)
            ok, lines = fail_first(root, mode, against)
            results[f'fail-first {mode}'] = ok, ''
            found += lines
    print(f'\n### Tested\n\nBase `{base}`, tree `{root}`, built from `{built}`.\n')
    for name in chosen:
        shown = f'mac/scripts/format {base}' if name == 'format' else \
            ' '.join(cmds[name]).replace(f'{TOOLKIT}/scripts', 'mac/scripts')
        ok, detail = results[name]
        print(f'- `{shown}`: {"pass" if ok else "FAIL"}{f" ({detail})" if detail else ""}')
    for name, why in skipped.items():
        print(f'- skipped {name}: {why}')
    if opt.fail_first:
        print('\n#### Fail first\n\n' + '\n'.join(found))
    sys.exit(0 if all(ok for ok, _ in results.values()) else 1)


ALL_SKIPPED = """\
1/1 Test #1860: data.move-test ...................***Skipped   0.34 sec

100% tests passed out of 1

The following tests did not run:
\t1860 - data.move-test (Skipped)
"""
NONE_FOUND = """\
Test project /tmp/build/play
No tests were found!!!
Errors while running CTest
"""
MIXED = """\
1/3 Test    #1: arch.link_layers .................   Passed    0.04 sec
2/3 Test   #20: arch.version .....................   Passed    0.03 sec
3/3 Test #1860: data.move-test ...................***Skipped   0.01 sec

100% tests passed out of 3

The following tests did not run:
\t1860 - data.move-test (Skipped)
"""
NO_GAME = '100% tests passed out of 277\n\nThe following tests did not run:\n' + \
    ''.join(f'\t{n} - data.mode-{n} (Skipped)\n' for n in range(274))
FAILED = """\
67% tests passed, 1 tests failed out of 3

The following tests did not run:
\t  3 - sk (Skipped)

The following tests FAILED:
\t  2 - bad (Failed)
"""


def self_test():
    assert checks_for(['docs/a.md', 'README.md'])[0] == ['metrics']
    assert checks_for(['src/sim/a.cpp'])[0] == ['unit', 'arch', 'mp', 'gate', 'format', 'metrics', 'smoke']
    assert checks_for(['src/renderer/a.cpp'])[0] == ORDER
    assert checks_for(['src/app/a.cpp'])[1] == {'render': 'no change under src/renderer or to a shader'}
    assert checks_for(['assets/x.frag'])[0] == ORDER
    assert checks_for(['srcs/a.cpp', 'mac/scripts/x'])[0] == ['metrics']
    assert checks_for(['tools/check_blueprint_lookups.py'])[0] == ['arch', 'metrics']
    assert all('--no-tests=error' in argv for name, argv in commands('b').items() if argv[0] == 'ctest')
    assert ctest_counts(ALL_SKIPPED) == (1, 0, 1)
    assert verdict(0, ctest_counts(ALL_SKIPPED)) == (False, 'nothing ran (0 passed, 1 skipped, 0 failed of 1)')
    assert ctest_counts(NONE_FOUND) is None and verdict(8, None) == (False, 'no tests found')
    assert verdict(0, ctest_counts(MIXED)) == (True, '2 passed, 1 skipped, 0 failed of 3')
    assert verdict(0, ctest_counts(NO_GAME)) == (False, 'mostly skipped (3 passed, 274 skipped, 0 failed of 277)')
    assert verdict(8, ctest_counts(FAILED)) == (False, '1 passed, 1 skipped, 1 failed of 3')
    assert verdict(0, catch2_counts('All tests passed (60 assertions in 13 test cases)\n')) == \
        (True, '13 passed, 0 skipped, 0 failed of 13')
    assert verdict(2, catch2_counts('test cases: 5 | 3 passed | 1 failed | 1 skipped\n'))[0] is False
    assert verdict(0, catch2_counts('No tests ran\n'))[0] is False
    print('prove self-test passed')


if __name__ == '__main__':
    main()
