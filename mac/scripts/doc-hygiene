#!/usr/bin/env python3
"""Docs that agents read stay true to the current direction.

  mac/scripts/doc-hygiene            fail on a dead term (mac/agents/dead-terms.txt) in live guidance
"""
import pathlib
import subprocess
import sys

MAC = pathlib.Path(__file__).resolve().parent.parent
LIVE = ['README.md', 'AGENTS.md', 'docs', 'agents', 'scripts', 'tools', 'recipe']
SKIP = {'agents/dead-terms.txt', 'scripts/check', 'scripts/doc-hygiene'}


def terms(path):
    return [t.strip() for t in path.read_text().splitlines() if t.strip() and not t.startswith('#')]


def live_files(mac):
    tracked = subprocess.run(['git', '-C', str(mac), 'ls-files', *LIVE], capture_output=True, text=True).stdout.split()
    return [mac / f for f in tracked if f not in SKIP] + [mac.parent / n for n in ('AGENTS.md', 'CLAUDE.md') if (mac.parent / n).exists()]


def hits(files, dead):
    found = []
    for f in files:
        try:
            text = f.read_text(errors='ignore')
        except (IsADirectoryError, FileNotFoundError):
            continue
        for n, line in enumerate(text.splitlines(), 1):
            found += [f'{f}:{n}: {t}' for t in dead if t in line]
    return found


def main():
    found = hits(live_files(MAC), terms(MAC / 'agents/dead-terms.txt'))
    for line in found:
        print(f'dead term: {line}')
    sys.exit(1 if found else 0)


main()
