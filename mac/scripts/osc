#!/usr/bin/env bash
# A menu for mac/scripts/play: pick the window, HUD, frame cap, UI scale, a rebuild and extra game options by key, see the
# exact play command, and start the game. Works from any folder as `osc` once linked:
#   ln -s ~/Projects/OpenSupCom/mac/scripts/osc ~/.local/bin/osc
# Remembers the last choices in ~/.config/osc-launcher.
#   mac/scripts/osc        the menu
#   mac/scripts/osc --go   play with the last choices, no menu
set -u
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)" || exit 1
saved="$HOME/.config/osc-launcher"
log="$HOME/Library/Application Support/opensupcom/logs/opensupcom.log"

window=video hud=on cap=game scale=default build=off extra=
windows=(video full 1920x1080 2560x1440 2880x1620)
caps=(game 0 -2 60 120)
scales=(default 1.25 1.5 2)

load() {
    [ -f "$saved" ] || return 0
    local key value
    while IFS='=' read -r key value; do
        case $key in
            window|hud|cap|scale|build|extra) printf -v "$key" '%s' "$value" ;;
        esac
    done < "$saved"
}

save() {
    mkdir -p "$(dirname "$saved")"
    printf 'window=%s\nhud=%s\ncap=%s\nscale=%s\nbuild=%s\nextra=%s\n' \
        "$window" "$hud" "$cap" "$scale" "$build" "$extra" > "$saved"
}

next_in() {
    local current=$1; shift
    local all=("$@") i
    for i in "${!all[@]}"; do
        [ "${all[$i]}" = "$current" ] && { echo "${all[$(( (i + 1) % ${#all[@]} ))]}"; return; }
    done
    echo "${all[0]}"
}

command_args() {
    args=()
    [ "$build" = on ] && args+=(--build)
    [ "$hud" = off ] && args+=(--no-hud)
    case $window in
        video) ;;
        full) args+=(--full) ;;
        *) args+=(--size "${window%x*}" "${window#*x}") ;;
    esac
    local game=()
    [ "$cap" != game ] && game+=(--fps-cap "$cap")
    [ "$scale" != default ] && game+=(--ui-scale "$scale")
    # shellcheck disable=SC2206
    [ -n "$extra" ] && game+=($extra)
    [ ${#game[@]} -gt 0 ] && args+=(-- "${game[@]}")
    return 0
}

describe() {
    case $1 in
        video) echo "the game's Video options" ;;
        full) echo "full screen 2560x1440" ;;
        game) echo "the game's default" ;;
        0) echo "none" ;;
        -2) echo "2 below the refresh rate" ;;
        default) echo "the display's" ;;
        *) echo "$1" ;;
    esac
}

play() {
    save
    command_args
    echo "mac/scripts/play ${args[*]}"
    exec "$here/play" "${args[@]}"
}

menu() {
    while true; do
        command_args
        clear
        cat <<EOF
OpenSupCom on the Mac  ($(git -C "$here" rev-parse --short HEAD) on $(git -C "$here" branch --show-current))

  1  Window         $(describe "$window")
  2  Metal HUD      $hud
  3  Frame cap      $(describe "$cap")
  4  UI scale       $(describe "$scale")
  5  Rebuild first  $build
  6  Extra options  ${extra:-none}

  Return  play       d  which driver ran last    l  open the game log    q  quit

  Runs: mac/scripts/play ${args[*]}
EOF
        read -rsn1 key
        case $key in
            1) window=$(next_in "$window" "${windows[@]}") ;;
            2) hud=$(next_in "$hud" on off) ;;
            3) cap=$(next_in "$cap" "${caps[@]}") ;;
            4) scale=$(next_in "$scale" "${scales[@]}") ;;
            5) build=$(next_in "$build" off on) ;;
            6) echo; read -rep "Extra game options (blank for none; see play's --help list): " extra ;;
            d) echo; grep -m1 -i driver "$log" || echo "no log yet"; read -rsn1 -p "(any key)" ;;
            l) open -a Console "$log" 2>/dev/null || echo "no log yet" ;;
            q) save; echo; exit 0 ;;
            '') echo; play ;;
        esac
    done
}

load
case ${1:-} in
    --go) play ;;
    '') menu ;;
    *) echo "usage: osc [--go]  (see the top of $0)" >&2; exit 2 ;;
esac
