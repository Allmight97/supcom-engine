#!/bin/sh
# Enforce STATUS.md's size rules: at most 170 lines, at most 5 lines per "## Tracks" block.
#   mac/scripts/status-limits [FILE]   (default STATUS.md; "-" reads stdin)
set -eu
file=${1:-STATUS.md}
content=$(cat "$file")
lines=$(printf '%s\n' "$content" | wc -l | tr -d ' ')
failed=0
[ "$lines" -le 170 ] || { echo "STATUS.md has $lines lines (limit 170): move run details to mac/log/, procedures to mac/docs/toolchain.md." >&2; failed=1; }
long=$(printf '%s\n' "$content" | awk '/^## /{t=($0=="## Tracks")} t&&/^- \*\*/{if(n>5)print name; name=$0; n=0} t&&name{n++} END{if(n>5)print name}')
[ -z "$long" ] || { echo "STATUS.md track over 5 lines (detail belongs in the session's log): $long" >&2; failed=1; }
exit $failed
